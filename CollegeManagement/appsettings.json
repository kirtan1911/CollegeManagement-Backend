{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // Replace with your local SQL Server connection string
    "conn": "Server=(localdb)\\mssqllocaldb;Database=CollegeManagement;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    // Set via dotnet user-secrets or appsettings.Development.json — never commit a real key
    "Key": "",
    "Issuer": "CollegeManagementSystem",
    "Audience": "CollegeManagementSystemUsers",
    "DurationInMinutes": 60
  },
  "EmailSettings": {
    // Set SenderEmail and AppPassword via dotnet user-secrets or appsettings.Development.json
    "SenderEmail": "",
    "SenderName": "College Management System",
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "AppPassword": ""
  }
}